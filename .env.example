# -----------------------------------------------------------------------------
# ClickHouse：Dashboard 后端读取业务数据；生产建议使用只读账号
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=your-clickhouse-host
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=weibo
READONLY_USER=your-readonly-user
READONLY_PASSWORD=your-readonly-password

# -----------------------------------------------------------------------------
# 通用 LLM 服务：OpenAI-compatible API，数据修复脚本和 Dashboard 可共用
# LLM_API_KEY 可留空；仅当服务要求鉴权时填写
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://your-openai-compatible-host/v1
LLM_API_KEY=your-optional-api-key
LLM_MODEL=mimo-v2-flash

# -----------------------------------------------------------------------------
# Dashboard AI 研判总结：只基于后端聚合指标生成解释，不直连 ClickHouse
# DASHBOARD_LLM_MODEL 未设置时回退 LLM_MODEL；默认代码兜底为 mimo-v2.5-pro
# -----------------------------------------------------------------------------
DASHBOARD_LLM_ENABLED=1
DASHBOARD_LLM_MODEL=mimo-v2.5-pro
DASHBOARD_LLM_TIMEOUT=300
DASHBOARD_LLM_MAX_TOKENS=8192

# -----------------------------------------------------------------------------
# Dashboard 缓存：不设则降级到进程内 dict（多 worker 不共享）
# 本地：redis://localhost:16379/0
# 生产带密码：redis://:<password>@<host>:<port>/<db>
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:16379/0
